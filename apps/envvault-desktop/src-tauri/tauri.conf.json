{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnvVault",
  "version": "0.1.0",
  "identifier": "dev.envvault.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "EnvVault", "width": 1120, "height": 760, "minWidth": 840, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
